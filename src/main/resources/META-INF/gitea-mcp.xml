<!-- Gitea tools for the IDE's MCP server. Loaded only when the MCP Server
     plugin is installed and enabled (plugin.xml: optional dependency). -->
<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
    <xi:include href="/META-INF/gitea-mcp-platform.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <extensions defaultExtensionNs="com.intellij">
        <mcpServer.mcpToolset implementation="com.github.hypercookie.giteaplugin.mcp.GiteaMcpToolset"/>
    </extensions>
</idea-plugin>
