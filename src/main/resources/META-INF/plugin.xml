<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.hypercookie.giteaplugin</id>
    <name>Gitea</name>
    <vendor>hypercookie</vendor>
    <description><![CDATA[
        <p>Provides integration with <a href="https://about.gitea.com/">Gitea</a> pull requests.</p>
        <ul>
          <li>List, search and filter the pull requests of the current repository in the Pull Requests tool window.</li>
          <li>Open a pull request to see its commits, changed files, status checks and timeline, and view file diffs.</li>
          <li>Review in the editor: see review threads next to the code of the checked-out pull request branch, reply to and resolve them, and add new comments from the gutter.</li>
          <li>Collect comments in a pending review and submit it as approval, comment or change request.</li>
          <li>Check out a pull request branch from the list.</li>
          <li>After pushing a branch without an open pull request, get a notification that opens Gitea's page to create one.</li>
          <li>See the status checks of each commit in a column of the Git log.</li>
        </ul>
        <p>To configure, open <b>Settings / Preferences</b> and go to Version Control | Gitea. Tested with Gitea 1.27.</p>
        <p>Requires the Git plugin.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>
    <dependencies>
        <module name="intellij.platform.collaborationTools"/>
        <module name="intellij.platform.vcs.impl"/>
        <module name="intellij.platform.vcs.log.impl"/>
    </dependencies>


    <extensions defaultExtensionNs="com.intellij">
        <toolWindow factoryClass="com.github.hypercookie.giteaplugin.pullrequest.toolwindow.GiteaToolWindowFactory"
                    id="Gitea Pull Requests" anchor="left" doNotActivateOnStart="true" canCloseContents="true"
                    icon="com.github.hypercookie.giteaplugin.icons.GiteaIcons.Gitea"/>
        <diff.DiffExtension implementation="com.github.hypercookie.giteaplugin.pullrequest.diff.GiteaCommentDiffExtension"/>
        <fileEditorProvider implementation="com.github.hypercookie.giteaplugin.pullrequest.timeline.GiteaTimelineEditorProvider"/>
        <completion.contributor language="any"
                                implementationClass="com.github.hypercookie.giteaplugin.pullrequest.review.mention.GiteaMentionCompletionContributor"/>
        <typedHandler implementation="com.github.hypercookie.giteaplugin.pullrequest.review.mention.GiteaMentionTypedHandler"/>
        <editorFactoryListener implementation="com.github.hypercookie.giteaplugin.pullrequest.review.editor.GiteaReviewInEditorController"/>
        <editorNotificationProvider implementation="com.github.hypercookie.giteaplugin.pullrequest.PrReviewEditorNotificationProvider"/>
        <vcsLogCommitStatusProvider implementation="com.github.hypercookie.giteaplugin.log.GiteaCommitStatusProvider"/>
        <notificationGroup id="Gitea" displayType="BALLOON" icon="com.github.hypercookie.giteaplugin.icons.GiteaIcons.Gitea"/>
        <notificationGroup id="Gitea Pull Request Suggestions" displayType="BALLOON"
                           icon="com.github.hypercookie.giteaplugin.icons.GiteaIcons.Gitea"/>
        <projectConfigurable
                parentId="vcs"
                instance="com.github.hypercookie.giteaplugin.settings.GiteaConfigurable"
                id="com.github.hypercookie.giteaplugin.settings.GiteaConfigurable"
                displayName="Gitea"/>
    </extensions>

    <actions>
        <action id="Gitea.Diff.Review.PreviousComment" class="com.github.hypercookie.giteaplugin.pullrequest.diff.GiteaPreviousCommentAction"
                text="Previous Comment" description="Go to the previous review comment of the pull request" icon="AllIcons.General.ChevronUp"/>
        <action id="Gitea.Diff.Review.NextComment" class="com.github.hypercookie.giteaplugin.pullrequest.diff.GiteaNextCommentAction"
                text="Next Comment" description="Go to the next review comment of the pull request" icon="AllIcons.General.ChevronDown"/>
        <action id="Gitea.Diff.Review.IncludeResolvedComments" class="com.github.hypercookie.giteaplugin.pullrequest.diff.GiteaIncludeResolvedCommentsAction"
                text="Include Resolved Comments in Navigation">
            <add-to-group group-id="Diff.EditorPopupMenu" anchor="last"/>
        </action>
    </actions>

    <projectListeners>
        <listener class="com.github.hypercookie.giteaplugin.pullrequest.create.GiteaPushPrNotifier"
                  topic="git4idea.push.GitPushListener"/>
    </projectListeners>

    <applicationListeners>
        <listener class="com.github.hypercookie.giteaplugin.GiteaPluginUnloadListener"
                  topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>

</idea-plugin>
