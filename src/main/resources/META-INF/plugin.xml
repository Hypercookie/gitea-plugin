<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.hypercookie.giteaplugin</id>
    <name>Gitea</name>
    <vendor>hypercookie</vendor>
    <description><![CDATA[
        <p>Gitea integration: browse pull requests, read and reply to review comments right in the editor, and submit reviews (approve, comment, request changes) — without leaving IntelliJ.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>
    <dependencies>
        <module name="intellij.platform.collaborationTools"/>
    </dependencies>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow factoryClass="com.github.hypercookie.giteaplugin.pullrequest.GiteaPullRequestsToolWindowFactory"
                    id="Gitea Pull Requests" anchor="right" icon="com.github.hypercookie.giteaplugin.icons.GiteaIcons.Gitea"/>
        <diff.DiffExtension implementation="com.github.hypercookie.giteaplugin.pullrequest.diff.GiteaCommentDiffExtension"/>
        <editorNotificationProvider implementation="com.github.hypercookie.giteaplugin.pullrequest.PrReviewEditorNotificationProvider"/>
        <notificationGroup id="Gitea" displayType="BALLOON" icon="com.github.hypercookie.giteaplugin.icons.GiteaIcons.Gitea"/>
        <applicationConfigurable
                parentId="vcs"
                instance="com.github.hypercookie.giteaplugin.settings.GiteaConfigurable"
                id="com.github.hypercookie.giteaplugin.settings.GiteaConfigurable"
                displayName="Gitea"/>
    </extensions>

    <projectListeners>
        <listener class="com.github.hypercookie.giteaplugin.pullrequest.comments.WorkingCopyCommentEditorListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
        <listener class="com.github.hypercookie.giteaplugin.pullrequest.comments.WorkingCopyCommentEditorListener"
                  topic="git4idea.repo.GitRepositoryChangeListener"/>
    </projectListeners>
</idea-plugin>
